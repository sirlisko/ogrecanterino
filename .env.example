# Public address of the app; Caddy gets an HTTPS certificate for DOMAIN automatically.
DOMAIN=sounds.example.com
PUBLIC_URL=https://sounds.example.com

# openssl rand -hex 32
SESSION_SECRET=

# Discord application (https://discord.com/developers/applications)
# OAuth2 redirect to add in the portal: ${PUBLIC_URL}/auth/callback
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_BOT_TOKEN=

# Comma-separated server IDs: only members can log in, and the bot only joins these servers.
ALLOWED_GUILD_IDS=
# Comma-separated Discord user IDs that can edit or delete anything.
ADMIN_DISCORD_IDS=

# Local development only: adds a "Log in as dev GM" button.
DEV_LOGIN=false
